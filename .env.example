# Copy to .env for local development. On the host (Render/Railway/Fly) set these as environment variables.
# Everything else (Google, R2, auction rules, captain passwords) is set from the admin panel
# and stored encrypted in MongoDB.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fedcup?retryWrites=true&w=majority

# Long random secret. Encrypts stored credentials and signs logins. NEVER change it after setup
# (stored credentials and captain passwords would become unreadable).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MASTER_KEY=

# First admin login only. Change the password from the admin panel afterwards.
ADMIN_PASSWORD=

# Frontend URL(s), comma separated. No trailing slash.
CORS_ORIGIN=http://localhost:5173

PORT=4000
